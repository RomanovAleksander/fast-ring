<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup is false (SPEC 2); this file exists so the manifest attribute
     is explicit rather than relying on framework defaults. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
